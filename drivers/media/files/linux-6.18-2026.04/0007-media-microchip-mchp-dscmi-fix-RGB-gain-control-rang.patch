From 66d17ddb5005803ecf80a24d1415a5c526665378 Mon Sep 17 00:00:00 2001
From: svc-fpga-sol <svc-fpga-sol@microchip.com>
Date: Wed, 11 Nov 2026 20:08:11 +0530
Subject: [PATCH] media: microchip: mchp-dscmi: fix RGB gain control range and
 types

Widen the RGB gain/control range to 0..255 (MCHP_DSCMI_GAIN_CTL_MAX and
MCHP_DSCMI_CTL_MAX from 220, MCHP_DSCMI_CTL_MIN from 25 to 0), and switch
the contrast_scale, second_constraint and RGB gain variables from u32 to
int in mchp_dscmi_s_ctrl() and mchp_image_enhancement_update_ctrls() so
that intermediate negative values are handled correctly.

Signed-off-by: svc-fpga-sol <svc-fpga-sol@microchip.com>
---
 drivers/media/platform/microchip/mchp-dscmi.c             | 8 ++++----
 .../platform/microchip/microchip-image-enhancement.c      | 2 +-
 2 files changed, 5 insertions(+), 5 deletions(-)

diff --git a/drivers/media/platform/microchip/mchp-dscmi.c b/drivers/media/platform/microchip/mchp-dscmi.c
index 700e2bd663a7..de9ac6ad8901 100644
--- a/drivers/media/platform/microchip/mchp-dscmi.c
+++ b/drivers/media/platform/microchip/mchp-dscmi.c
@@ -114,9 +114,9 @@
 #define MCHP_DSCMI_B_GAIN_CTL_DEFAULT		0x8A
 #define MCHP_DSCMI_CONTRAST_CTL_DEFAULT		0x9A
 #define MCHP_DSCMI_BRIGHTNESS_CTL_DEFAULT	0x89
-#define MCHP_DSCMI_GAIN_CTL_MAX			220
-#define MCHP_DSCMI_CTL_MAX			220
-#define MCHP_DSCMI_CTL_MIN			25
+#define MCHP_DSCMI_GAIN_CTL_MAX			255
+#define MCHP_DSCMI_CTL_MAX			255
+#define MCHP_DSCMI_CTL_MIN			0
 #define MCHP_DSCMI_CTL_STEP			1
 #define MCHP_DSCMI_Q_FACTOR_CTL_MAX		52
 #define MCHP_DSCMI_Q_FACTOR_CTL_MIN		25
@@ -1188,7 +1188,7 @@ static void mchp_dscmi_update_q_factor_table(struct mchp_dscmi_fpga *mchp_dscmi,
 static int mchp_dscmi_s_ctrl(struct v4l2_ctrl *ctrl)
 {
 	struct mchp_dscmi_fpga *mchp_dscmi;
-	u32 contrast_scale, second_constraint, r_gain, g_gain, b_gain;
+	int contrast_scale, second_constraint, r_gain, g_gain, b_gain;
 
 	mchp_dscmi = container_of(ctrl->handler,
 				  struct mchp_dscmi_fpga, ctrl_handler);
diff --git a/drivers/media/platform/microchip/microchip-image-enhancement.c b/drivers/media/platform/microchip/microchip-image-enhancement.c
index 9af2e804dce1..34601ffe2007 100644
--- a/drivers/media/platform/microchip/microchip-image-enhancement.c
+++ b/drivers/media/platform/microchip/microchip-image-enhancement.c
@@ -253,7 +253,7 @@ static inline int contrast_scale_cal(int contrast)
 
 static void mchp_image_enhancement_update_ctrls(struct mchp_image_enhancement *image_enhancement)
 {
-	u32 contrast_scale, second_constraint, r_gain_val, g_gain_val, b_gain_val;
+	int contrast_scale, second_constraint, r_gain_val, g_gain_val, b_gain_val;
 
 	contrast_scale = contrast_scale_cal(image_enhancement->contrast);
 	second_constraint = second_constraint_cal(image_enhancement->brightness,
-- 
