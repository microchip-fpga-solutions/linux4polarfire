menu "Cache Drivers"

config AX45MP_L2_CACHE
	bool "Andes Technology AX45MP L2 Cache controller"
	depends on RISCV
	select RISCV_NONSTANDARD_CACHE_OPS
	help
	  Support for the L2 cache controller on Andes Technology AX45MP platforms.

config SIFIVE_CCACHE
	bool "Sifive Composable Cache controller"
	depends on ARCH_MICROCHIP_POLARFIRE || ARCH_SIFIVE || ARCH_STARFIVE
	depends on PERF_EVENTS
	help
	  Support for the composable cache controller on SiFive platforms.

config SIFIVE_ECACHE_PMU
	bool "Sifive Extensible Cache PMU"
	depends on ARCH_MICROCHIP_POLARFIRE || ARCH_SIFIVE || ARCH_STARFIVE
	depends on PERF_EVENTS
	help
	  Support for the extensible cache pmu on SiFive platforms.
	  SiFive extensible cache is shared by all cores. User can
	  use the perf tool to select the extensible cache pmu events
	  to monitor program or whole system cache performance.

config SIFIVE_PL2
	bool "Sifive private L2 Cache controller"
	depends on ARCH_MICROCHIP_POLARFIRE || ARCH_SIFIVE || ARCH_STARFIVE
	depends on PERF_EVENTS
	default y
	help
	  Support for the private L2 cache controller on SiFive platforms.

endmenu
