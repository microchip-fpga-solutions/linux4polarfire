/dts-v1/;
#include "sama5d4.dtsi"

/ {
	model = "Ingenico islero";
	compatible = "atmel,sama5d4ing", "atmel,sama5d4", "atmel,sama5";

	chosen {
		bootargs = "console=ttyS0,115200 consoleblank=0 ubi.mtd=1 root=ubi0:ubifs-vol1 rootfstype=ubifs rootwait=1 noinitrd rw";
		/* bootargs = "console=ttyS0,115200 consoleblank=0 root=/dev/nfs rw nfsroot=10.23.7.56:/home/lcruau/sw/telium3/nfsroot ip=dhcp rootwait ing_security_mod=enable:0"; */
	};

	memory {
		reg = <0x21000000 0x1F000000>;
	};

	aliases {
		serial0 = &usart3;
		serial1 = &usart4; /* carte d'extension */
	};

	clocks {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		main_clock: clock@0 {
			compatible = "atmel,osc", "fixed-clock";
			clock-frequency = <12000000>;
		};
	};

	ahb {
		apb {
			lcd_bus@f0000000 {
				status = "okay";

				lcd@f0000000 {
					status = "okay";
				};

				lcdovl1@f0000140 {
					status = "okay";
				};

				lcdovl2@f0000240 {
					status = "okay";
				};

				lcdheo1@f0000340 {
					status = "okay";
				};
			};
			mmc1: mmc@fc000000 {
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_mmc1_clk_cmd_dat0 &pinctrl_mmc1_dat1_3 >;
				status = "okay";
				slot@0 {
					reg = <0>;
					bus-width = <4>;
				};
			};

/*
			mmc0: mmc@f8000000 {
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_mmc0_clk_cmd_dat0 &pinctrl_mmc0_dat1_3 &pinctrl_mmc0_cd>;
				status = "okay";
				slot@1 {
					reg = <1>;
					bus-width = <4>;
					cd-gpios = <&pioE 5 0>;
				};
			};
*/
			macb0: ethernet@f8020000 {
			  local-mac-address = [00 03 81 66 3d 8e];
				phy-mode = "mii";
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_macb0_mii>;
				status = "okay";
			};

			i2c2: i2c@f8024000 {
				status = "okay";

				24c256@50 {
					compatible = "24c256";
					reg = <0x50>;
					pagesize = <64>;
				};
			};

			usart3: serial@fc00c000 {
				status = "okay";
			};

			usart4: serial@fc010000 {
				status = "okay";
			};

			pinctrl@fc06a000 {
				board {
					pinctrl_mmc0_cd: mmc0_cd {
						atmel,pins =
							<AT91_PIOE 5 AT91_PERIPH_GPIO AT91_PINCTRL_PULL_UP_DEGLITCH>;
					};
					pinctrl_usba_vbus: usba_vbus {
						atmel,pins =
							<AT91_PIOE 31 AT91_PERIPH_GPIO AT91_PINCTRL_DEGLITCH>;
					};
				};
			};
		};
		usb0: gadget@00400000 {
			/*atmel,vbus-gpio = <&pioE 31 GPIO_ACTIVE_HIGH>;*/
			/*pinctrl-names = "default";*/
			/*pinctrl-0 = <&pinctrl_usba_vbus>;*/
			status = "okay";
		};

		usb1: ohci@00500000 {
			num-ports = <3>;
			atmel,vbus-gpio = <0 /* &pioE 10 GPIO_ACTIVE_LOW */
					   &pioA 17 GPIO_ACTIVE_HIGH
					   0 /* &pioE 12 GPIO_ACTIVE_LOW */
					  >;
			status = "okay";
		};

		usb2: ehci@00600000 {
			status = "okay";
		};

		nand0: nand@80000000 {
			nand-bus-width = <8>;
			nand-ecc-mode = "soft_bch";
			nand-on-flash-bbt;
			status = "okay";
			/* Hynix NAND 128MiB 3,3V 8-bit */
			/* 16 MiB */
			partition@0 {
				label = "secure world";
				reg = <0x0 0x1000000>;
			};
			/* 112 MiB */
			partition@1000000 {
				label = "rootfs";
				reg = <0x1000000 0x07000000>;
			};
		};
	};
};

