/dts-v1/;
#include "sama5d4.dtsi"

/ {
	model = "Atmel SAMA5D4-EK";
	compatible = "atmel,sama5d4ek", "atmel,sama5d4", "atmel,sama5";

	chosen {
		bootargs = "console=ttyS0,115200 root=/dev/sda1 rootwait ignore_loglevel earlyprintk noinitrd rw";
	};

	memory {
		reg = <0x20000000 0x20000000>;
	};

	aliases {
		serial0 = &usart4;
		serial1 = &usart3;
	};

	clocks {
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		main_clock: clock@0 {
			compatible = "atmel,osc", "fixed-clock";
			clock-frequency = <12000000>;
		};
	};

	leds {
		compatible = "gpio-leds";
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_led_gpio>;

		power_led {
			label = "power_red";
			gpios = <&pioE 9 GPIO_ACTIVE_HIGH>;
		};

		user_led {
			label = "user_led";
			gpios = <&pioE 8 GPIO_ACTIVE_HIGH>;
			default-state = "on";
			linux,default-trigger = "heartbeat";
		};
	};

	ahb {
		apb {
			lcd_bus@f0000000 {
				status = "okay";

				lcd@f0000000 {
					status = "okay";
				};

				lcdovl1@f0000140 {
					status = "okay";
				};

				lcdovl2@f0000240 {
					status = "okay";
				};

				lcdheo1@f0000340 {
					status = "okay";
				};
			};
/*
			mmc0: mmc@f8000000 {
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_mmc0_clk_cmd_dat0 &pinctrl_mmc0_dat1_3 &pinctrl_mmc0_cd>;
				status = "okay";
				slot@1 {
					reg = <1>;
					bus-width = <4>;
					cd-gpios = <&pioE 5 GPIO_ACTIVE_HIGH>;
				};
			};
*/
			mmc1: mmc@fc000000 {
				pinctrl-names = "default";
				pinctrl-0 = <&pinctrl_mmc1_clk_cmd_dat0 &pinctrl_mmc1_dat1_3 &pinctrl_mmc1_cd>;
				status = "okay";
				slot@0 {
					reg = <0>;
					bus-width = <4>;
					cd-gpios = <&pioE 14 GPIO_ACTIVE_HIGH>;
				};
			};

			macb0: ethernet@f8020000 {
				phy-mode = "rmii";
				status = "okay";
			};

			/* usart3: serial@fc00c000 {
				status = "okay";
			}; */

			usart4: serial@fc010000 {
				status = "okay";
			};

			pinctrl@fc06a000 {
				board {
					pinctrl_mmc0_cd: mmc0_cd {
						atmel,pins =
							<AT91_PIOE 5 AT91_PERIPH_GPIO AT91_PINCTRL_PULL_UP_DEGLITCH>;
					};
					pinctrl_mmc1_cd: mmc1_cd {
						atmel,pins = <
							AT91_PIOE 14 AT91_PERIPH_GPIO AT91_PINCTRL_PULL_UP_DEGLITCH
							/* AT91_PIOE 15 AT91_PERIPH_GPIO AT91_PINCTRL_NONE */ /* PWR_MCI1 */
							>;
					};
					pinctrl_usba_vbus: usba_vbus {
						atmel,pins =
							<AT91_PIOE 31 AT91_PERIPH_GPIO AT91_PINCTRL_DEGLITCH>;
					};
					pinctrl_led_gpio: led_gpios {
						atmel,pins = <
							AT91_PIOE 8 AT91_PERIPH_GPIO AT91_PINCTRL_NONE
							AT91_PIOE 9 AT91_PERIPH_GPIO AT91_PINCTRL_NONE
							>;
					};
				};
			};
		};

		nand0: nand@80000000 {
			nand-bus-width = <8>;
			nand-ecc-mode = "soft_bch";
			nand-on-flash-bbt;
			status = "okay";

			at91bootstrap@0 {
				label = "at91bootstrap";
				reg = <0x0 0x40000>;
			};

			bootloader@40000 {
				label = "bootloader";
				reg = <0x40000 0x80000>;
			};

			bootloaderenv@c0000 {
				label = "bootloader env";
				reg = <0xc0000 0xc0000>;
			};

			dtb@180000 {
				label = "device tree";
				reg = <0x180000 0x80000>;
			};

			kernel@200000 {
				label = "kernel";
				reg = <0x200000 0x600000>;
			};

			rootfs@800000 {
				label = "rootfs";
				reg = <0x800000 0x0f800000>;
			};
		};

		usb0: gadget@00400000 {
			/*atmel,vbus-gpio = <&pioE 31 GPIO_ACTIVE_HIGH>;*/
			/*pinctrl-names = "default";*/
			/*pinctrl-0 = <&pinctrl_usba_vbus>;*/
			status = "okay";
		};

		usb1: ohci@00500000 {
			num-ports = <3>;
			atmel,vbus-gpio = <0 /* &pioE 10 GPIO_ACTIVE_LOW */
					   &pioE 11 GPIO_ACTIVE_LOW
					   &pioE 12 GPIO_ACTIVE_LOW
					  >;
			status = "okay";
		};

		usb2: ehci@00600000 {
			status = "okay";
		};

		vdec0: vdec@00300000 {
			status = "okay";
		};

	};
};
