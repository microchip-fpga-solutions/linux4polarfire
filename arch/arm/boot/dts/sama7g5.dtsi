#include "skeleton.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/clock/at91.h>
#include <dt-bindings/dma/at91.h>

/ {
	model = "Atmel SAMA7G5 family SoC";
	compatible = "atmel,sama7g5";

	interrupt-parent = <&gic>;

	aliases {
		serial0 = &uart0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0x0>;
		};
	};

	/* 256 M */
	memory {
		reg = <0x60000000 0x10000000>;
	};

    clocks {
	    compatible = "simple-bus";
	    #address-cells = <1>;
	    #size-cells = <0>;

	    mck: mainck {
		    compatible = "fixed-clock";
		    #clock-cells = <0>;
		    clock-frequency = <20000000>;
	    };
	    baseclk: baseclk{
		    compatible = "fixed-clock";
		    #clock-cells = <0>;
		    clock-frequency = <12000000>;
	    };
	    multclk: multclk {
		    compatible = "fixed-clock";
		    #clock-cells = <0>;
		    clock-frequency = <96000000>;
	    };

    };

    ahb {
	    compatible = "simple-bus";
	    #address-cells = <1>;
	    #size-cells = <1>;
	    ranges;

	    apb {
		    compatible = "simple-bus";
		    #address-cells = <1>;
		    #size-cells = <1>;
		    ranges;

		    gic: interrupt-controller@4b001000 {
			    compatible = "arm,cortex-a7-gic";
			    #interrupt-cells = <3>;
			    #address-cells = <0>;
			    interrupt-controller;
			    interrupt-parent;
			    reg = <0x4B001000 0x1000>,
				    <0x4B002000 0x2000>;
		    };

		    tcb0: timer@e2814000 {
			    compatible = "atmel,tcbmmio";
			    reg = <0xe2814000 0x100>;
			    interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
			    clocks = <&mck>;
			    status = "disabled";
		    };

		    uart0: serial@e1818200 {
			    compatible = "atmel,at91sam9260-usart";
			    reg = <0xe1818200 0x200>;
			    interrupts = <GIC_SPI 38 IRQ_TYPE_LEVEL_HIGH>;
			    clocks = <&mck>;
			    clock-names = "usart";
			    dmas = <&dma0 AT91_XDMAC_DT_PERID(5)>,
				    <&dma0 AT91_XDMAC_DT_PERID(6)>;
			    dma-names = "rx", "tx";
			    atmel,use-dma-rx;
			    atmel,use-dma-tx;
			    status = "okay";
		    };

		    uart1: serial@e181c200 {
			    compatible = "atmel,at91sam9260-usart";
			    reg = <0xe181c200 0x200>;
			    interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
			    clocks = <&mck>;
			    clock-names = "usart";
			    dmas = <&dma0 AT91_XDMAC_DT_PERID(7)>,
				    <&dma0 AT91_XDMAC_DT_PERID(8)>;
			    dma-names = "rx", "tx";
			    atmel,use-dma-rx;
			    atmel,use-dma-tx;
			    status = "disabled";
		    };

		spi0: spi@e181c200 {
			compatible = "atmel,at91rm9200-spi";
			reg = <0xe181c400 0x200>;
			interrupts = <GIC_SPI 39 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&mck>;
			clock-names = "spi_clk";
			dmas = <&dma0 AT91_XDMAC_DT_PERID(7)>,
				    <&dma0 AT91_XDMAC_DT_PERID(8)>;
			dma-names = "rx", "tx";
//atmel,fifo-size = <0>;                          
                                #address-cells = <1>;                            
                                #size-cells = <0>;                               
                                status = "okay"; 
};


		    uart2: serial@e1820200 {
			    compatible = "atmel,at91sam9260-usart";
			    reg = <0xe1820200 0x200>;
			    interrupts = <GIC_SPI 40 IRQ_TYPE_LEVEL_HIGH>;
			    clocks = <&mck>;
			    clock-names = "usart";
			    dmas = <&dma0 AT91_XDMAC_DT_PERID(9)>,
				    <&dma0 AT91_XDMAC_DT_PERID(10)>;
			    dma-names = "rx", "tx";
			    atmel,use-dma-rx;
			    atmel,use-dma-tx;
			    status = "okay";
		    };

		    uart3: serial@e1824200 {
			    compatible = "atmel,at91sam9260-usart";
			    reg = <0xe1824200 0x200>;
			    interrupts = <GIC_SPI 41 IRQ_TYPE_LEVEL_HIGH>;
			    clocks = <&mck>;
			    clock-names = "usart";
			    dmas = <&dma0 AT91_XDMAC_DT_PERID(11)>,
				    <&dma0 AT91_XDMAC_DT_PERID(12)>;
			    dma-names = "rx", "tx";
			    atmel,use-dma-rx;
			    atmel,use-dma-tx;
			    status = "okay";
		    };

		sdmmc0: sdio-host@e1204000 {
			compatible = "atmel,sama5d2-sdhci";
			reg = <0xe1204000 0x300>;
		        bus-width = <4>;
			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&mck>, <&multclk>, <&baseclk>;
			clock-names = "hclock", "multclk", "baseclk";
			max-frequency = <48000000>;
			status = "okay";
		};


		    dma0: dma-controller@e2808000 {
			    compatible = "atmel,sama7-dma";
			    reg = <0xe2808000 0x1000>;
			    interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
			    #dma-cells = <1>;
			    clocks = <&mck>;
			    clock-names = "dma_clk";
			    status = "okay";
		    };

		    dma1: dma-controller@e2808c000 {
			    compatible = "atmel,sama7-dma";
			    reg = <0xe280c000 0x1000>;
			    interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
			    #dma-cells = <1>;
			    clocks = <&mck>;
			    clock-names = "dma_clk";
			    status = "okay";
		    };

		    dma2: dma-controller@e1200000 {
			    compatible = "atmel,sama7-dma";
			    reg = <0xe1200000 0x1000>;
			    interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
			    #dma-cells = <1>;
			    clocks = <&mck>;
			    clock-names = "dma_clk";
			    status = "okay";
		    };

			/* Clocksource timer. */
			timer1: pit64@e1800000 {
				compatible = "atmel,pit64";
				reg = <0xe1800000 0x100>;
				clocks = <&mck>;
				status = "okay";
			};

			/* Clockevent timer. */
			timer2: pit64@e1804000 {
				compatible = "atmel,pit64";
				reg = <0xe1804000 0x100>;
				interrupts = <GIC_SPI 69 IRQ_TYPE_LEVEL_HIGH>;
				clocks = <&mck>;
				status = "okay";
			};
	    };
    };
};
