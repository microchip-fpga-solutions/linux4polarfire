#include "skeleton.dtsi"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/clock/at91.h>

/ {
	model = "Atmel SAMA7G5 family SoC";
	compatible = "atmel,sama7g5";
	interrupt-parent = <&aic>;

	aliases {
		serial0 = &uart0;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a7";
			reg = <0>;
		};
	};

	/* I put it 64MB, but it must be 1024MB */
	memory {
		reg = <0x20000000 0x4000000>;
	};

        clocks {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		mck: mainck {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <20000000>;
		};
	};

	ahb {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <1>;
		ranges;

		apb {
			compatible = "simple-bus";
			#address-cells = <1>;
			#size-cells = <1>;
			ranges;

			aic: interrupt-controller@fc020000 {
				#interrupt-cells = <3>;
				compatible = "atmel,sama5d4-aic";
				interrupt-controller;
				reg = <0xfc020000 0x200>;
				atmel,external-irqs = <74>;
			};

			tcb0: timer@f800c000 {
				compatible = "atmel,tcbmmio";
				reg = <0xf800c000 0x100>;
				interrupts = <35 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&mck>;
			};

			uart0: serial@f801c000 {
				compatible = "atmel,at91sam9260-usart";
				reg = <0xf801c000 0x200>;
				interrupts = <24 IRQ_TYPE_LEVEL_HIGH 7>;
				clocks = <&mck>;
				clock-names = "usart";
			};

			chipid@fc069000 {
				compatible = "atmel,sama7g5-chipid";
				reg = <0xfc069000 0x8>;
			};

		};
	};
};
